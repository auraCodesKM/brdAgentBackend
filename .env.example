# Environment Configuration for Advanced RAG Backend

# Analytics / Logging
LOG_LEVEL="INFO"

# Upstash Hosted Redis (Mumbai - Hackfest Server)
# CREATE A FREE ACCOUNT AT UPSTASH.COM AND PASTE CREDENTIALS HERE
UPSTASH_REDIS_REST_URL="https://your_url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_token_here"
UPSTASH_REDIS_REGION="Mumbai"
UPSTASH_REDIS_TIO_URL="rediss://default:your_token_here@your_url.upstash.io:6379"

# HuggingFace Local Cache Directory (Prevents 50GB GitHub commit bloat)
# HuggingFace Local Cache Directory (Change this path if you want models on a different drive)
HF_HOME=./hf_cache
HF_TOKEN=your_huggingface_token_here

# Redis Settings (If running local instead of Upstash)
REDIS_URL=redis://localhost:6379/0
CACHE_THRESHOLD=0.88

# Models Configuration
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_NAME=qwen2.5:32b
OLLAMA_API_KEY=ollama

# Embeddings & Reranker
BGE_M3_MODEL_PATH=BAAI/bge-m3
BGE_RERANKER_PATH=BAAI/bge-reranker-large

# Whisper
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda
WHISPER_UNLOAD_AFTER_USE=true

# MinerU / Image extraction parameters
MINER_U_OUTPUT_DIR=./data/mineru_parsed
